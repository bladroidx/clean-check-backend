meta {
  name: Check — idempotent retry
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/checks
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{apiKey}}
  idempotency-key: bruno-fixed-idempotency-key-001
}

body:json {
  {
    "imei": "{{validImei}}",
    "capabilities": ["identity.model"]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("a retry returns the SAME check, and does not charge twice", function () {
    // Run this request twice. The check_id must not change: a retried paid check that runs again
    // charges twice, and one that answers differently breaks the promise the header makes.
    const first = bru.getVar("firstCheckId");
    if (first) {
      expect(res.getBody().check_id).to.equal(first);
    } else {
      bru.setVar("firstCheckId", res.getBody().check_id);
    }
  });
}

docs {
  Send this twice. The second response is the stored first response, replayed verbatim.

  `Idempotency-Key` is mandatory on `POST /v1/checks` for exactly this reason — a network retry on
  a paid call must not become a second charge.
}
