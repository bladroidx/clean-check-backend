meta {
  name: Deep check — fetch by id
  type: http
  seq: 2
  tags: [
    paid
  ]
}

get {
  url: {{baseUrl}}/v1/deep_checks/{{lastCheckId}}
  body: none
  auth: none
}

headers {
  authorization: Bearer {{apiKey}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the same check_id we just created", function () {
    expect(res.getBody().check_id).to.equal(bru.getVar("lastCheckId"));
  });

  test("never returns the full IMEI", function () {
    expect(JSON.stringify(res.getBody())).to.not.include(bru.getEnvVar("validImei"));
  });

  test("belongs to this tenant only — a 404 for a made-up id", function () {
    // Not asserted here (would need a second request), but see the docs note below.
    expect(res.getBody()).to.have.property("sections");
  });
}

docs {
  Run **01 Deep check — full report** first — it saves `check_id` into the runtime variable
  `lastCheckId` that this request reads.

  This is how a caller picks up a check that came back `inconclusive(awaiting_provider)` because
  `DEEP_CHECK_WAIT_MS` ran out before imei24 answered: poll this endpoint (never the supplier
  again) until the section resolves.

  A check id that exists but belongs to a different tenant returns 404, not 403 — the same
  reasoning as the auth 401: telling an attacker "that id exists but isn't yours" is a
  confirmation they didn't earn.
}
