meta {
  name: Deep check — idempotent retry (replay)
  type: http
  seq: 4
  tags: [
    paid
  ]
}

post {
  url: {{baseUrl}}/v1/deep_checks
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{apiKey}}
  idempotency-key: {{retryIdempotencyKey}}
}

body:json {
  {
    "imei": "{{validImei}}",
    "capabilities": ["blacklist.gsma"]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("returns the SAME check as the first call", function () {
    // A retried paid check that runs again charges twice; one that answers differently breaks
    // the promise the Idempotency-Key header makes.
    expect(res.getBody().check_id).to.equal(bru.getVar("firstCheckId"));
  });

  test("still charges nothing on replay", function () {
    expect(res.getBody().billing.credits_charged).to.equal(0);
    expect(res.getBody().billing).to.not.have.property("credits_remaining");
  });
}

docs {
  Run **03 Deep check — idempotent retry (first call)** first — it generates the shared
  `retryIdempotencyKey`. This request replays the identical `Idempotency-Key`, same IMEI, same
  capabilities, and the response must be the FIRST response replayed verbatim, not a second paid
  check — even though nothing is charged either way in single-consumer mode, a recomputed replay
  answering differently would still break the promise the header makes.
}
