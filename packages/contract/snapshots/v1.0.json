            "luhn_valid": {
              "type": "boolean"
            }
          },
          "required": [
            "imei_masked",
            "luhn_valid"
          ],
          "additionalProperties": false
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
