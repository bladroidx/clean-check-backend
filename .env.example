# Copy to .env. The example documents the NAMES; never commit a value.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Internal cache / dedupe / abuse key material. Never returned to a caller, never logged.
# MUST be at least 32 bytes: the 15-digit IMEI space is enumerable in seconds, so a short pepper
# does not pseudonymise anything. The process refuses to boot below the floor.
#   generate with:  head -c 48 /dev/urandom | base64
SERVER_PEPPER=

# The paid routes appear ONLY when this is set. Without it the service serves the free offline
# tier, which is a supported mode rather than a degraded one: it costs nothing to run.
DATABASE_URL=postgres://imei:imei@localhost:5432/imei_check?sslmode=disable

# Loaded into memory at boot. Replace the seed with an Osmocom import before any real use.
TAC_SOURCE_FILE=testdata/tac-seed.json

# Where the catalogue YAML lives. Defaults to packages/providers/catalogue.
# PROVIDER_CATALOGUE_DIR=

# Public base URL, used to build the feedback_url an async supplier POSTs its answer back to.
# Wrong here means standard orders are placed and their answers land nowhere.
# PUBLIC_BASE_URL=https://api.example.com

# --- Provider credentials. Read from the platform secret store in production, never baked into an
# --- image and never committed here.
#
# A provider whose credentials are absent is simply NOT BUILT -- not built-and-broken. Running with
# none is the free tier plus a database, and every paid section honestly reports
# unavailable(provider_not_configured) at zero cost.

# Supplier A -- legacy DHRU Fusion (form POST to /api/index.php).
# ALPHA_BASE_URL=https://supplier-a.example.com
# ALPHA_USERNAME=
# ALPHA_API_KEY=

# Supplier B -- modern DHRU reseller REST (bearer token, async feedback webhook).
# BETA_BASE_URL=https://supplier-b.example.com/api/v1
# BETA_TOKEN=
# Without this, inbound feedback webhooks are REFUSED rather than trusted. An absent secret must
# never mean "skip verification": anyone who learns the URL could otherwise post
# {"status":"success","replay":"<base64 of: Blacklist Status: Clean>"} about a stolen handset.
# BETA_WEBHOOK_SECRET=

# --- Worker intervals (apps/worker). Defaults shown.
# WORKER_POLL_INTERVAL_MS=30000
# WORKER_WEBHOOK_INTERVAL_MS=15000
# WORKER_RECONCILE_INTERVAL_MS=21600000
