# Copy to .env. The example documents the NAMES; never commit a value.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Internal cache / dedupe / abuse key material. Never returned to a caller, never logged.
# MUST be at least 32 bytes: the 15-digit IMEI space is enumerable in seconds, so a short pepper
# does not pseudonymise anything. The process refuses to boot below the floor.
#   generate with:  head -c 48 /dev/urandom | base64
SERVER_PEPPER=

DATABASE_URL=postgres://imei:imei@localhost:5432/imei_check?sslmode=disable

# Loaded into memory at boot. Replace the seed with an Osmocom import before any real use.
TAC_SOURCE_FILE=testdata/tac-seed.json

# --- M1: provider credentials. Read from the platform secret store in production, never baked
# --- into an image and never committed here.
# SICKW_API_KEY=
# IMEICHECK_USERNAME=
# IMEICHECK_API_ACCESS_KEY=
