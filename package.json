{
  "name": "imei-check",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sentinel": "vitest run apps/api/test/sentinel.test.ts",
    "test:integration": "echo 'Integration lane: start Postgres, apply db/migrations, then run the smoke path. See README.' && exit 0",
    "api:test": "cd bruno && bru run --env Local -r --exclude-tags paid",
    "schema:emit": "npm -w @imei-check/contract run schema:emit",
    "schema:diff": "node scripts/schema-diff.mjs",
    "lint": "eslint . --max-warnings 0",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "dev": "npm -w @imei-check/api run dev",
    "dev:worker": "npm -w @imei-check/worker run dev",
    "api:test:paid": "cd bruno && bru run --env Local -r --tags paid --env-var \"apiKey=${BRUNO_API_KEY:?set BRUNO_API_KEY to a seeded dev key first}\"",
    "seed:dev": "node --env-file-if-exists=.env scripts/seed-dev-tenant.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.10.2",
    "@types/pg": "8.11.10",
    "@usebruno/cli": "^4.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^17.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "js-yaml": "4.1.0",
    "pg": "8.13.1",
    "prom-client": "15.1.3"
  }
}
